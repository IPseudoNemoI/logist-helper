<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TabTextStyle">
        <item name="android:fontFamily">@font/stolzl_regular</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CalendarWeekDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/alt_dark</item>
        <item name="android:fontFamily">@font/stolzl_book</item>
    </style>

    <style name="CalendarWeekDayWeekend" parent="CalendarWeekDay">
        <item name="android:textColor">@color/red</item>
    </style>

    <style name="CalendarLegendItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/alt_dark</item>
        <item name="android:fontFamily">@font/stolzl_book</item>
    </style>

    <style name="ProfileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#A8AFBF</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ProfileValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#2B2D35</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>